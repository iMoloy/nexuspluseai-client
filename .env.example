# NexusPulse AI Client Environment Variables Configuration Example

# Backend API Service URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ImgBB Profile Picture Upload API Key
NEXT_PUBLIC_IMGBB_API_KEY=your_dummy_imgbb_api_key_here

# App Metadata
NEXT_PUBLIC_APP_NAME="NexusPulse AI"

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_dummy_nextauth_secret_key_here
NEXTAUTH_BACKEND_URL=http://localhost:5000/api/v1

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_dummy_google_client_id_here
GOOGLE_CLIENT_SECRET=your_dummy_google_client_secret_here

